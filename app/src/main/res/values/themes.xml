<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppleMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/background_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.AppleMusicPlayer.NowPlaying" parent="Theme.AppleMusicPlayer">
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>

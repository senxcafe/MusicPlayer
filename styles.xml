<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PillButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_pill_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TransportIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:layout_marginHorizontal">8dp</item>
    </style>

    <style name="TransportIconButtonLarge">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:layout_marginHorizontal">12dp</item>
    </style>

</resources>
